# ==============================================================================
# Weather & Transit Web - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# 실제 환경 변수 설정 시 본 파일을 복사하여 프로젝트 루트에 '.env'로 생성한 후
# 각 기관에서 발급받은 실제 API 인증키 값을 입력하여 사용하세요.
#
# 주의: '.env' 파일은 보안상 절대로 Git 저장소에 커밋/푸시하지 마세요. (.gitignore 처리됨)
# ==============================================================================

# 1. 기상청 API허브 인증키 (초단기실황 날씨 조회)
# - 발급처: https://apihub.kma.go.kr
# - 활용서비스: 기상청 API허브 > 동네예보조회서비스(2.0) > 초단기실황조회
KMA_APIHUB_KEY=your_kma_apihub_key_here

# 2. 서울 열린데이터광장 인증키 (지하철 실시간 도착 정보)
# - 발급처: https://data.seoul.go.kr
# - 활용서비스: 서울시 지하철 실시간 도착정보 (realtimeStationArrival)
SEOUL_SUBWAY_API_KEY=your_seoul_subway_key_here
SEOUL_DATA_API_KEY=your_seoul_subway_key_here

# 3. 공공데이터포털 일반 인증키 (서울특별시 버스도착정보조회)
# - 발급처: https://www.data.go.kr
# - 활용서비스: 서울특별시_버스도착정보조회 (노선별 getArrInfoByRouteAll, 저상버스 getLowArrInfoByStId)
# ※ 일반 인증키(Decoding) 사용 권장
DATA_GO_KR_API_KEY=your_data_go_kr_key_here

# 4. 백엔드 API 서버 URL (프론트엔드 연동용)
VITE_API_BASE_URL=http://localhost:8000

# 5. 피처 스키마(feature_schema.json) 경로 — 선택
# - 미지정 시 서버가 자동 탐색합니다: models/feature_schema.json → benchmarks/2026-10-14/feature_schema.json
# - 배포 슬롯(models/)에 32차원 자산을 넣을 때 스키마를 함께 두면 자동으로 그 스키마를 검증합니다.
# - 컨테이너/별도 배포에서 다른 위치를 쓰려면 아래 주석을 해제해 경로를 지정하세요.
# FEATURE_SCHEMA_PATH=./models/feature_schema.json
