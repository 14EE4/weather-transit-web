# ==========================================
# 1. API 키 및 보안 파일 (절대 커밋 금지)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# 2. Node.js / Frontend (React, Vite 등)
# ==========================================
node_modules/
dist/
dist-ssr/
build/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. Python / AI / Data
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# 가상환경 (venv, conda)
.venv/
venv/
ENV/
env/

# 대용량 데이터셋 및 가중치 파일 (CSV, 엑셀, 대용량 파일)
# ※ 100MB 이상 파일은 깃허브 업로드가 차단됩니다.
*.csv
*.xlsx
*.parquet
*.pt
*.pth
*.pkl
*.h5
raw_data/
data/통합데이터/

# 서빙용 경량 ONNX 추론 모델(각 4.7MB) 및 지하철/시계열 데이터셋은 배포를 위해 Git 추적 허용
!models/*.onnx
!models/*.json
!data/*.json
!data/*.db
# SQLite WAL 저널/공유메모리 임시 파일 및 런타임 캐시 (컨테이너 런타임 산출물 — 커밋 제외)
timeseries_cache.db
data/timeseries_cache.db
*.db-shm
*.db-wal
data/*.db-shm
data/*.db-wal

# Jupyter / Colab 임시 파일
.ipynb_checkpoints/

# ==========================================
# 4. OS 및 IDE 설정 파일
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

api_example/
AGENTS.md
