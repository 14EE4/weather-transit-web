FROM python:3.11-slim

WORKDIR /app

# 타임존 설정 (대한민국 표준시 KST, UTC+9)
ENV TZ=Asia/Seoul
ENV DEBIAN_FRONTEND=noninteractive

# 런타임 필수 패키지: libgomp1(ONNX Runtime OpenMP 가속), curl(헬스체크용), tzdata(한국 타임존 동기화)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# 레이어 캐시 활용을 위해 requirements.txt 먼저 복사 및 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 애플리케이션 소스, AI 모델 파일, 데이터셋 복사
#  - *.py: main.py, timeseries_cache.py, feature_schema.py 등 신규 파이썬 스크립트 일괄 복사
COPY *.py ./
COPY models/ ./models/
COPY data/ ./data/
# 피처 스키마(SSoT) — 컨테이너에서도 기동 시 차원·순서 검증을 수행합니다.
#  - models/feature_schema.json 및 benchmarks/ 경로 둘 다 온전히 배치되도록 보장
COPY benchmarks/2026-10-29/feature_schema.json ./benchmarks/2026-10-29/feature_schema.json
COPY models/feature_schema.json ./models/feature_schema.json

EXPOSE 8000

# 헬스체크: 10초 간격으로 /health 엔드포인트 점검 (모델 로딩 완료 확인)
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
