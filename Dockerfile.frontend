# --- Stage 1: Build Stage ---
FROM node:20-alpine AS builder

WORKDIR /app

# 공백이 포함된 디렉터리 경로를 안전하게 처리하기 위해 JSON 배열 문법(["src", "dest"]) 사용
COPY ["Weather-Transport Recommendation UI/package*.json", "./"]
RUN npm ci

# 소스 코드 전체 복사 (디렉터리 내부 파일들이 /app으로 복사됨)
COPY ["Weather-Transport Recommendation UI/", "./"]

# 도커 Nginx 리버스 프록시 연동을 위해 상대 경로(/api)로 API 기본 URL 주입
ENV VITE_API_BASE_URL=""

# 프로덕션 번들 빌드
RUN npm run build

# --- Stage 2: Production Runtime Stage ---
FROM nginx:alpine

# 커스텀 Nginx 리버스 프록시 설정 반영
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 빌드 산출물 복사
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

